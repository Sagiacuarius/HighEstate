{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "preserve",
    "lib": ["dom", "dom.iterable", "es2022"],
    "typeRoots": ["./node_modules/@types", "./web/node_modules/@types"]
  },
  "include": ["src/**/*.ts", "contracts/**/*.ts", "web/**/*.ts", "web/**/*.tsx"]
}
